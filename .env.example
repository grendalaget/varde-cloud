# Database — Turso (libSQL). Local dev can leave these unset: the app falls
# back to a plain `file:./varde.db` SQLite database — no server needed.
# Prod: create a DB (`turso db create varde`) and a token (`turso db tokens create`).
TURSO_DATABASE_URL="libsql://varde-your-instance.turso.io"
TURSO_AUTH_TOKEN=""

# better-auth — generate with `openssl rand -base64 32` (or any random 32+ chars).
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"

# Canonical origin of this app. Dev: http://localhost:3000 — prod: https://varde.games
BETTER_AUTH_URL="http://localhost:3000"

# Billing — Polar (merchant of record). Org access token from Polar
# dashboard → Settings → Developers. Leave unset to keep billing dormant
# (pricing stays "coming soon"). Sandbox and production are separate worlds.
# POLAR_ACCESS_TOKEN="polar_oat_..."
# POLAR_SERVER="sandbox"            # "production" when live
# POLAR_WEBHOOK_SECRET="whsec_..."  # webhook endpoint: /api/auth/polar/webhooks
# POLAR_ANCHOR_MONTHLY_PRODUCT_ID=""
# POLAR_ANCHOR_YEARLY_PRODUCT_ID=""
# POLAR_ANCHOR_PLUS_PRODUCT_ID=""

# OAuth providers (future — plug into `socialProviders` in src/lib/auth.ts)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# HeroUI Pro registry token — only needed if/when we add @heroui-pro packages.
# HEROUI_PRO_TOKEN=""
