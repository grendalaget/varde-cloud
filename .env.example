# Database — Turso (libSQL). Local dev can leave these unset: the app falls
# back to a plain `file:./varde.db` SQLite database — no server needed.
# Prod: create a DB (`turso db create varde`) and a token (`turso db tokens create`).
TURSO_DATABASE_URL="libsql://varde-your-instance.turso.io"
TURSO_AUTH_TOKEN=""

# better-auth — generate with `openssl rand -base64 32` (or any random 32+ chars).
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"

# Canonical origin of this app. Dev: http://localhost:3000 — prod: https://varde.games
# Optional on Vercel: production falls back to https://varde.games, preview
# deploys fall back to their own VERCEL_URL, everything else to localhost.
BETTER_AUTH_URL="http://localhost:3000"

# Billing — Polar (merchant of record). Org access token from Polar
# dashboard → Settings → Developers. Leave unset to keep billing dormant
# (pricing stays "coming soon"). Sandbox and production are separate worlds.
# POLAR_ACCESS_TOKEN="polar_oat_..."   # sandbox token (previews/dev)
# POLAR_PROD_ACCESS_TOKEN="polar_oat_..."  # prod token; wins when POLAR_SERVER=production
# POLAR_SERVER="sandbox"            # "production" when live
# POLAR_WEBHOOK_SECRET="whsec_..."  # webhook endpoint: /api/auth/polar/webhooks
# POLAR_ANCHOR_MONTHLY_PRODUCT_ID=""
# POLAR_ANCHOR_YEARLY_PRODUCT_ID=""
# POLAR_ANCHOR_PLUS_PRODUCT_ID=""

# Federation — HS256 secret shared with the hosted control plane. The site
# mints short-lived desktop sign-in tokens at /auth/desktop; the CP verifies
# them with the SAME value in its own env var (VARDE_FEDERATION_SECRET —
# set via `fly secrets set` on the cp.varde.games deploy, never committed).
# Generate with `openssl rand -base64 32`.
# FEDERATION_SECRET=""

# Hosted control plane the docs demos act on (group/invite/server/device-link
# calls in /api/cp/*). Defaults to https://cp.varde.games; point at a local
# CP (`--auth-mode federated`) for development.
# VARDE_CP_URL="https://cp.varde.games"

# OAuth providers (future — plug into `socialProviders` in src/lib/auth.ts)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# HeroUI Pro CI/CD license key — from https://heroui.pro/dashboard (NOT the
# personal/MCP token). `pnpm install` runs the @heroui-pro/react postinstall,
# which downloads the Pro component artifacts when this is set. Required as a
# Vercel env var for deploys; without it the install warns and skips (build
# then fails on missing Pro component styles/modules).
# HEROUI_AUTH_TOKEN=""

# Email — transactional mail (verification, password reset) via Resend,
# rendered from the react-email templates in src/emails/. Without a key the
# actionable link is printed to the server console instead, so local dev
# still works end to end. EMAIL_FROM must be a sender on a verified Resend
# domain.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Varde <spawn@varde.games>"
